generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Outlet {
  id            String         @id
  name          String
  paused        Boolean        @default(false)
  autoDispatch  Boolean        @default(false)
  latitude      Float?
  longitude     Float?
  users         User[]
  products      Product[]
  orders        Order[]
  deliveryZones DeliveryZone[]
  invitations   Invitation[]
}

model User {
  id                  String               @id @default(uuid())
  outletId            String
  outlet              Outlet               @relation(fields: [outletId], references: [id])
  name                String
  role                String
  sessions            Session[]
  orders              Order[]
  riderAvailable      Boolean              @default(false)
  assignments         DeliveryAssignment[]
  disabledAt          DateTime?
  authVersion         Int                  @default(0)
  developmentOnly     Boolean              @default(false)
  credential          Credential?
  invitationsCreated  Invitation[]         @relation("InvitationIssuer")
  recoveryInvitations Invitation[]         @relation("InvitationTarget")
  deliveryOffers      DeliveryOffer[]
  savedAddresses      SavedAddress[]
  email               String?
  emailVerifiedAt     DateTime?
  emailCodes          EmailCode[]
  supportTickets      SupportTicket[]  @relation("TicketCustomer")
  assignedTickets     SupportTicket[]  @relation("TicketAssignee")
}

model Session {
  id          String   @id @default(uuid())
  tokenHash   String   @unique
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  authVersion Int      @default(0)
  authMethod  String   @default("development")
}

model Product {
  id          String  @id
  outletId    String
  outlet      Outlet  @relation(fields: [outletId], references: [id])
  name        String
  description String
  category    String
  pricePaise  Int
  vegetarian  Boolean
  available   Boolean @default(true)
}

model Order {
  id              String               @id @default(uuid())
  number          Int                  @unique @default(autoincrement())
  outletId        String
  outlet          Outlet               @relation(fields: [outletId], references: [id])
  customerId      String
  customer        User                 @relation(fields: [customerId], references: [id])
  idempotencyKey  String
  requestHash     String
  fulfilment      String
  status          String               @default("awaiting_acceptance")
  paymentStatus   String               @default("pending")
  subtotalPaise   Int
  taxPaise        Int
  deliveryPaise   Int
  totalPaise      Int
  version         Int                  @default(0)
  createdAt       DateTime             @default(now())
  items           OrderItem[]
  events          OrderEvent[]
  paymentEvents   PaymentEvent[]
  deliveryAddress Json?
  assignments     DeliveryAssignment[]
  offers          DeliveryOffer[]
  payments        Payment[]

  @@unique([customerId, idempotencyKey])
  @@index([outletId, status, createdAt])
}

model OrderItem {
  id        String @id @default(uuid())
  orderId   String
  order     Order  @relation(fields: [orderId], references: [id])
  productId String
  name      String
  quantity  Int
  unitPaise Int
}

model OrderEvent {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id])
  actorId   String
  action    String
  reason    String?
  createdAt DateTime @default(now())
}

model PaymentEvent {
  id          String   @id
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id])
  provider    String
  amountPaise Int
  createdAt   DateTime @default(now())
}

model AuditEvent {
  id         String   @id @default(uuid())
  outletId   String
  actorId    String
  action     String
  resourceId String
  detail     String?
  createdAt  DateTime @default(now())

  @@index([outletId, createdAt])
}

model OutboxEvent {
  id          String    @id @default(uuid())
  outletId    String
  kind        String
  resourceId  String
  payload     Json
  createdAt   DateTime  @default(now())
  processedAt DateTime?
}

model DeliveryZone {
  id              String  @id @default(uuid())
  outletId        String
  outlet          Outlet  @relation(fields: [outletId], references: [id])
  postalCode      String
  name            String
  deliveryPaise   Int
  active          Boolean @default(true)
  approved        Boolean @default(false)
  developmentOnly Boolean @default(true)

  @@unique([outletId, postalCode])
}

model DeliveryAssignment {
  id            String            @id @default(uuid())
  orderId       String
  order         Order             @relation(fields: [orderId], references: [id])
  riderId       String
  rider         User              @relation(fields: [riderId], references: [id])
  status        String            @default("assigned")
  isActive      Boolean           @default(true)
  version       Int               @default(0)
  failureReason String?
  otpHash       String?
  otpSalt       String?
  otpExpiresAt  DateTime?
  otpIssuedAt   DateTime?
  otpIssueCount Int               @default(0)
  otpAttempts   Int               @default(0)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  location      Json?
  locationAt    DateTime?
  locationRecordedAt DateTime?
  locationLease String?
  events        AssignmentEvent[]

  @@index([riderId, isActive, createdAt])
  @@index([orderId, createdAt])
}

model AssignmentEvent {
  id           String             @id @default(uuid())
  assignmentId String
  assignment   DeliveryAssignment @relation(fields: [assignmentId], references: [id])
  actorId      String
  action       String
  reason       String?
  createdAt    DateTime           @default(now())
}

model Credential {
  userId       String   @id
  user         User     @relation(fields: [userId], references: [id])
  handle       String   @unique
  passwordHash String
  changedAt    DateTime @default(now())
}

model Invitation {
  id              String    @id @default(uuid())
  outletId        String
  outlet          Outlet    @relation(fields: [outletId], references: [id])
  createdById     String
  createdBy       User      @relation("InvitationIssuer", fields: [createdById], references: [id])
  userId          String?
  user            User?     @relation("InvitationTarget", fields: [userId], references: [id])
  tokenHash       String    @unique
  handle          String
  name            String
  role            String
  kind            String    @default("create")
  developmentOnly Boolean   @default(false)
  expiresAt       DateTime
  usedAt          DateTime?
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())

  @@index([outletId, createdAt])
}

model AuthThrottle {
  key      String   @id
  attempts Int
  resetAt  DateTime

  @@index([resetAt])
}

/// A time-limited offer of one ready order to one rider. A partial unique index
/// (see the migration) allows only one live offer per rider and per order, which
/// is what prevents double-booking.
model DeliveryOffer {
  id          String    @id @default(uuid())
  outletId    String
  orderId     String
  order       Order     @relation(fields: [orderId], references: [id])
  riderId     String
  rider       User      @relation(fields: [riderId], references: [id])
  status      String    @default("offered")
  score       Float?
  expiresAt   DateTime
  respondedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([orderId, status])
  @@index([riderId, status])
  @@index([outletId, status, expiresAt])
}

/// A customer's own address book. Orders copy the address they use (a snapshot),
/// so editing or deleting a saved address never changes past orders.
model SavedAddress {
  id         String   @id @default(uuid())
  customerId String
  customer   User     @relation(fields: [customerId], references: [id])
  label      String
  recipient  String
  phone      String
  line1      String
  city       String
  postalCode String
  landmark   String?
  latitude   Float?
  longitude  Float?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([customerId, updatedAt])
}

/// A short-lived, single-use code emailed to a customer to verify their email
/// address or to reset a forgotten passphrase. Only an HMAC of the code is stored.
model EmailCode {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  purpose   String
  email     String
  codeHash  String
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, purpose, createdAt])
  @@index([createdAt])
}

/// One attempt to pay for an order through a payment provider. Money is only
/// ever considered received when the server has verified it with the provider
/// (signed webhook or a direct lookup), never because the app said so.
model Payment {
  id                String    @id @default(uuid())
  orderId           String
  order             Order     @relation(fields: [orderId], references: [id])
  outletId          String
  provider          String
  providerOrderId   String?
  providerPaymentId String?
  amountPaise       Int
  currency          String    @default("INR")
  /// created | paid | failed | expired | cancelled | mismatch
  status            String    @default("created")
  method            String?
  failureCode       String?
  failureReason     String?
  expiresAt         DateTime
  paidAt            DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  refunds           Refund[]

  @@unique([provider, providerOrderId])
  @@unique([provider, providerPaymentId])
  @@index([orderId, createdAt])
  @@index([status, expiresAt])
}

model Refund {
  id               String   @id @default(uuid())
  paymentId        String
  payment          Payment  @relation(fields: [paymentId], references: [id])
  orderId          String
  outletId         String
  amountPaise      Int
  reason           String
  /// requested | processing | succeeded | failed
  status           String   @default("requested")
  providerRefundId String?
  failureReason    String?
  requestedById    String?
  idempotencyKey   String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([orderId, idempotencyKey])
  @@index([paymentId])
  @@index([orderId, createdAt])
}

/// Remembers webhook deliveries so a retried delivery is applied only once.
model WebhookEvent {
  id          String    @id
  provider    String
  type        String
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
}

/// A customer's help request, optionally about one of their orders. The thread
/// is a conversation with the outlet; staff can also leave internal notes the
/// customer never sees.
model SupportTicket {
  id                    String           @id @default(uuid())
  number                Int              @unique @default(autoincrement())
  outletId              String
  customerId            String
  customer              User             @relation("TicketCustomer", fields: [customerId], references: [id])
  orderId               String?
  category              String
  subject               String
  /// open (needs staff) | pending_customer | resolved | closed
  status                String           @default("open")
  priority              String           @default("normal")
  assignedToId          String?
  assignedTo            User?            @relation("TicketAssignee", fields: [assignedToId], references: [id])
  rating                Int?
  ratingComment         String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  firstResponseAt       DateTime?
  resolvedAt            DateTime?
  lastCustomerMessageAt DateTime         @default(now())
  lastStaffMessageAt    DateTime?
  customerReadAt        DateTime?
  messages              SupportMessage[]

  @@index([outletId, status, updatedAt])
  @@index([customerId, updatedAt])
  @@index([orderId])
}

model SupportMessage {
  id         String        @id @default(uuid())
  ticketId   String
  ticket     SupportTicket @relation(fields: [ticketId], references: [id])
  authorId   String
  /// customer | staff | system
  authorRole String
  /// Internal notes are for staff only.
  internal   Boolean       @default(false)
  body       String
  createdAt  DateTime      @default(now())

  @@index([ticketId, createdAt])
}
