# Copy to backend/.env. Use a dedicated non-production database for development.
DATABASE_URL=postgresql://pista:replace_me@localhost:5432/pista
NODE_ENV=development
PORT=3001
HOST=127.0.0.1
# Explicit opt-in. Refused when NODE_ENV=production.
DEV_ADAPTERS=false
DASHBOARD_ORIGIN=http://localhost:5173
# At least 32 random characters. Required for issuing/verifying delivery codes.
DELIVERY_OTP_SECRET=
# Initial owner setup only; leave false while serving the API.
ALLOW_OWNER_BOOTSTRAP=false
# Gateway, SMS, push and Petpooja adapters are not configured in this slice.

# Optional OSRM-compatible routing base URL; no fabricated ETA when unset.
MAPS_ROUTING_URL=
# Optional Photon-compatible geocoding endpoint for explicit area/landmark searches.
MAPS_GEOCODING_URL=

# Email for customer verification and passphrase reset (free tiers work).
# MAIL_PROVIDER: log (default: nothing sent, codes appear in this server's log) | resend | brevo
MAIL_PROVIDER=log
# MAIL_FROM must be a sender verified with the provider, e.g. no-reply@yourdomain.in
MAIL_FROM=
RESEND_API_KEY=
BREVO_API_KEY=
# Stay inside the free tier (Resend allows 100 a day).
MAIL_DAILY_LIMIT=80

# Payments. `simulated` moves no money and works only in explicit development or
# private-beta mode. `razorpay` needs the three secrets below (server only).
PAYMENT_PROVIDER=simulated
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Unpaid orders are closed after this many minutes (minimum 15).
UNPAID_ORDER_MINUTES=30

# Customer support: a request waiting longer than this for a first reply is
# flagged overdue in the owner app.
SUPPORT_SLA_MINUTES=60

# Push notifications. Alerts always appear in the in-app inbox; `fcm` also wakes
# the phone. Needs a Firebase project; keep the service-account key server-side.
PUSH_PROVIDER=none
FCM_PROJECT_ID=
# Either the JSON text or a path to the file:
FCM_SERVICE_ACCOUNT=
FCM_SERVICE_ACCOUNT_FILE=
# Promotions and reminders per customer per day (opt-in only; order updates are never capped).
PUSH_PROMO_DAILY_CAP=1
PUSH_MARKETING_DAILY_CAP=2
# Percent of eligible customers held back from each campaign to measure real lift.
PUSH_HOLDOUT_PERCENT=10
# Support photos are deleted after this many days.
SUPPORT_ATTACHMENT_DAYS=90
# Set to "true" to switch off the background pollers (tests, one-off scripts).
NOTIFICATIONS_POLL_DISABLED=
NOTIFICATIONS_CAMPAIGNS_DISABLED=

# Set to "true" to switch off the 5-minute offers and rating-prompt timer.
ENGAGEMENT_DISABLED=

# Security: set true only when a reverse proxy or tunnel on this machine fronts the API,
# so per-address rate limits see real client addresses.
TRUST_PROXY=false
RATE_LIMIT_ANONYMOUS_PER_MIN=90
RATE_LIMIT_SIGNED_IN_PER_MIN=600
