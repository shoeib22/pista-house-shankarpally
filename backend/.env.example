# Copy to backend/.env. Use a dedicated non-production database for development.
DATABASE_URL=postgresql://pista:replace_me@localhost:5432/pista
NODE_ENV=development
PORT=3001
HOST=127.0.0.1
# Explicit opt-in. Refused when NODE_ENV=production.
DEV_ADAPTERS=false
DASHBOARD_ORIGIN=http://localhost:5173
# At least 32 random characters. Required for issuing/verifying delivery codes.
DELIVERY_OTP_SECRET=
# Initial owner setup only; leave false while serving the API.
ALLOW_OWNER_BOOTSTRAP=false
# Gateway, SMS, push and Petpooja adapters are not configured in this slice.

# Optional OSRM-compatible routing base URL; no fabricated ETA when unset.
MAPS_ROUTING_URL=
# Optional Photon-compatible geocoding endpoint for explicit area/landmark searches.
MAPS_GEOCODING_URL=

# Email for customer verification and passphrase reset (free tiers work).
# MAIL_PROVIDER: log (default: nothing sent, codes appear in this server's log) | resend | brevo
MAIL_PROVIDER=log
# MAIL_FROM must be a sender verified with the provider, e.g. no-reply@yourdomain.in
MAIL_FROM=
RESEND_API_KEY=
BREVO_API_KEY=
# Stay inside the free tier (Resend allows 100 a day).
MAIL_DAILY_LIMIT=80
