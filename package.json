{
  "name": "pista-house",
  "private": true,
  "workspaces": [
    "backend",
    "apps/employee_dashboard",
    "packages/web_api"
  ],
  "scripts": {
    "dev:api": "npm run dev -w backend",
    "dev:dashboard": "npm run dev -w apps/employee_dashboard",
    "build": "npm run build -w backend && npm run build -w apps/employee_dashboard",
    "test": "npm run test -w backend",
    "db:generate": "npm run db:generate -w backend",
    "db:migrate": "npm run db:migrate -w backend",
    "db:seed": "npm run db:seed -w backend",
    "contract:generate": "node scripts/generate-contract.mjs",
    "demo:orders": "node backend/scripts/demo-order.mjs",
    "demo:delivery": "node backend/scripts/demo-delivery.mjs",
    "auth:bootstrap": "npm run auth:bootstrap -w backend"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.10.1",
    "sharp": "^0.35.5"
  }
}
